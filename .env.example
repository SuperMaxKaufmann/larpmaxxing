# Load these settings through your shell or secret manager. Never commit real values.
# Model API keys are entered in onboarding and kept only in server memory.
# Optional source connections:
# GOOGLE_CLIENT_ID=your-desktop-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-desktop-oauth-client-secret-if-issued
# GMAIL_ACCESS_TOKEN=readonly-oauth-access-token
# SLACK_USER_TOKEN=authorized-human-user-oauth-token
# Claude plan access runs your own signed-in Claude Code CLI. Set this only if
# `claude` is not on PATH or in ~/.local/bin:
# CLAUDE_CLI_PATH=/absolute/path/to/claude
# Private data must stay outside this repository. Legacy setting retained after rename.
# OWN_WORDS_DATA_DIR=/absolute/private/path/outside/this/repository
# PORT=3210
